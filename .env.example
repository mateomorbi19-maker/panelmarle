# ============================================================================
#  Variables del Panel Marle Nails.
#  ----------------------------------------------------------------------------
#  Sin NINGUNA de estas el panel arranca igual, en modo demo con datos de
#  mentira. Eso sirve para mirar el diseño, no para trabajar.
#  Los valores reales salen del .env del proyecto del agente (carpeta de arriba).
# ============================================================================

# ── Los datos ───────────────────────────────────────────────────────────────
# De acá salen los chats, los mensajes, las alertas y los integrantes.
# Si faltan, el panel cae al mock y muestra conversaciones inventadas.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Responder desde el panel ────────────────────────────────────────────────
# OBLIGATORIAS para poder contestarle a una clienta. El panel no le habla a
# Meta: le habla a Chatwoot, que ya tiene resueltas las dos salidas (WhatsApp
# Cloud API e Instagram). El token NUNCA llega al navegador: se usa solo en el
# servidor.
#
# ⚠️ El token tiene que ser EL MISMO que usa el workflow del agente en n8n.
#    Ya pasó que el del archivo estuviera viejo y todo diera 401: ante ese
#    error, comparar contra el nodo "1ª Parte Respuesta1" ANTES que nada.
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=

# ── Opcional ────────────────────────────────────────────────────────────────
# Solo para el enlace "Abrir en ManyChat" en los chats que vengan de ahí. El
# número se ve en la URL al entrar a Live Chat:
#   app.manychat.com/fb<ESTE_NUMERO>/chat/...
# El enlace a Instagram (ig.me) NO necesita configuración: sale del usuario de
# la clienta.
MANYCHAT_ACCOUNT_ID=

# ── Todavía no existen ──────────────────────────────────────────────────────
# Checkouts abandonados (webhooks de Stripe). El PLAN de cada integrante
# también saldría de acá: Skool no lo manda.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
