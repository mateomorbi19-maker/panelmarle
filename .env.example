# STRIPE_WEBHOOK_SECRET=

# Chatwoot — botón "Atender" de las alertas (abre la conversación del lead)
# NEXT_PUBLIC_CHATWOOT_BASE_URL=
# NEXT_PUBLIC_CHATWOOT_ACCOUNT_ID=
# CHATWOOT_API_TOKEN=
